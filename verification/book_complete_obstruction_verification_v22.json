      "0<h<r*d",
      "d in {1,2}",
      "r*alpha=s*h",
      "F*alpha*beta=(beta-alpha-1)*h*(h+d)"
    ],
    "logical_step": "For F>0: 0 < Eplus*alpha = [r*(2*alpha-d*s)+alpha]/(h+d) < 1",
    "conclusions": {
      "L=3,F>0": "r=2*R,S=3*R,T=3*R+2",
      "L=4,F>0": "S=2*r,T=2*r+3",
      "L=3,F<0": "r=2*R-1,S=3*R-2,T=3*R,R>=2",
      "L=4,F<0": "S=2*r-1,T=2*r+2,r>=2"
